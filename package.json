{
  "name": "pokopiaapi",
  "version": "1.0.0",
  "description": "Pokopia API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "assets:manifest": "tsx scripts/assets/generate-manifest.ts",
    "assets:acquire": "tsx scripts/assets/acquire.ts",
    "assets:upload": "tsx scripts/assets/upload.ts",
    "assets:verify": "tsx scripts/assets/verify-public.ts",
    "assets:update-data": "tsx scripts/assets/update-data.ts",
    "test:assets": "vitest run tests/assets.test.ts",
    "docker:build": "docker build -t pokopiaapi .",
    "docker:run": "docker run -p 3000:3000 pokopiaapi"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "type": "module",
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/env": "^7.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "posthog-node": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
